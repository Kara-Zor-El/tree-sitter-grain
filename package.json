{
  "name": "tree-sitter-grain",
  "version": "0.1.0",
  "description": "Grain grammar for tree-sitter",
  "license": "MIT",
  "author": "Kara Wilson <kara.wilson.2005.08@gmail.com>",
  "repository": "https://github.com/KaraZorEl/tree-sitter-grain",
  "type": "module",
  "main": "bindings/node",
  "types": "bindings/node/index.d.ts",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "bindings.gyp",
    "bindings/node/*",
    "src/**",
    "*.wasm",
    "queries/*"
  ],
  "dependencies": {
    "node-addon-api": "^8.7.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.8",
    "tree-sitter": "^0.25.0",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test",
    "test:validate": "npm run build && node test.mjs",
    "generate": "tree-sitter generate",
    "build": "npm run generate && node-gyp rebuild",
    "build-wasm": "tree-sitter build --wasm",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  }
}
