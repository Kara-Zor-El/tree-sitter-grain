{
  "name": "@grain/tree-sitter-grain",
  "version": "0.1.0",
  "esy": {
    "build": [
      "dune build -p tree-sitter-grain --no-buffer"
    ],
    "buildEnv": {
      "DUNE_BUILD_DIR": "#{self.target_dir}"
    }
  },
  "dependencies": {
    "@opam/dune": ">= 3.17.1 < 4.0.0",
    "@opam/tree-sitter": "0.1.0",
    "ocaml": "5.2.0"
  },
  "installConfig": {
    "pnp": false
  }
}
